# Авторизация (Better Auth)
BETTER_AUTH_SECRET="сгенерировать: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Вход через Google (необязательно — без них кнопка Google скрыта)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
